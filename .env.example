# このファイルは「キー名だけ」をGitにコミットする。実際の値は .env.local に書く。
# .env.local は .gitignore 済み。絶対にコミットしないこと。

# --- サイト ---
# 末尾スラッシュなし。
# ローカル開発では http://localhost:3000
# Vercel（本番）では https://kouritsu-ouendan.com
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Supabase ---
# ダッシュボード > Project Settings > API から取得
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# service_role キーはブラウザに露出させないため NEXT_PUBLIC_ を付けない。
# 管理機能・ニュース自動収集を実装するまでは未設定でよい。
SUPABASE_SERVICE_ROLE_KEY=

# --- 将来のニュース自動収集用（MVPでは未使用） ---
# GitHub Actions から /api/ingest を叩くときの合言葉
CRON_SECRET=
