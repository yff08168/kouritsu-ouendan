# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# キー名だけのテンプレートはコミットする（実際の値は絶対に入れないこと）
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# 文科省の学校コードCSV（生成物のもと。再取得できるのでgitには入れない）
/data/mext-*.csv
/data/missing-kana.json

# Wikipediaの大会別記事のキャッシュ（再取得できる。約200記事）
/data/wikipedia-cache/
